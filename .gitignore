# ============================================================================
# claude_remembers .gitignore
# SECURITY: Prevents personal data from being pushed to public GitHub repo
# ============================================================================

# --- PERSONAL DATA (NEVER COMMIT) ---

# Config file (contains personal paths, generated by remember-setup.py)
config.yaml

# Filled questionnaire (personal data - any filename variation)
remember-questionnaire.txt
*QUESTIONNAIRE*

# Root CLAUDE.md (personal project instructions, generated by remember-setup)
CLAUDE.md

# Session handoff notes (regenerated every session by session-start/post-compact hooks)
NEXT_SESSION.md
**/NEXT_SESSION.md

# Session file snapshots (personal content, written by copy_chat_file.py)
**/chat-files/
**/history/

# --- PROJECT FOLDERS (PERSONAL CONTENT) ---
# Each entry below must match a folder_name in config.yaml's `projects:` list.
# Add a line here (and its contents are excluded automatically, including
# that project's own CLAUDE.md) whenever you add a new project folder.

general/
other/

# --- DATABASE / BACKUPS / OTHER LARGE OR PERSONAL FILES ---
# SQLite databases corrupt under concurrent sync writes and are both too
# large and too personal (full conversation history) to belong in git.

*.db
*.db-journal
*.db-wal
*.db-shm
*.db.bak-*

# Rotating database backups (db-backup/, written by remember-setup/startup_check)
db-backup/

# Memory export output (personal data, written by remember_export.py)
exports/

# Session logs, one subfolder per machine hostname
logs/

# Claude.ai/ChatGPT/Gemini export files staged for import (personal conversations),
# including nested subfolders (e.g. imports/chatgpt-import/, imports/claude-import/)
imports/**/*.json
imports/**/*.xlsx

# --- BUILD/RUNTIME ARTIFACTS ---

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# --- EDITOR/OS JUNK ---

# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/

# OS files
.DS_Store
Thumbs.db
*~
*.swp
*.swo
*.kate-swp

# --- CLAUDE CODE INTERNAL ---

# Claude Code auto-generated (lives in ~/.claude/, not here)
.claude/

# --- KEEP THESE (explicit overrides) ---

!imports/completed/.gitkeep
